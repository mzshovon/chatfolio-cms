# Base URL of the Chatfolio backend API (see Docs/ADMIN_PANEL_UI_REFERENCE.md).
# Server-only — read by next.config.ts to proxy `/api/v1/*` requests to
# `${BACKEND_API_URL}/v1/*`. Never exposed to the browser, so it must NOT
# have the NEXT_PUBLIC_ prefix. This avoids CORS entirely: the browser only
# ever calls same-origin `/api/...`, and Next's server forwards it.
BACKEND_API_URL=http://localhost:8000
